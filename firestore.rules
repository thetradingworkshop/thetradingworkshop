rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: broker_connections
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - brokerName: string (required)
    //   - environment: string (required, live/paper)
    //   - status: string (required)
    //   - authType: string (required)
    //   - lastSyncAt: string (optional)
    //   - createdAt: string (required)
    //   - updatedAt: string (required)
    //
    // Collection: broker_accounts (subcollection of broker_connections)
    // Document ID: auto-generated
    // Fields:
    //   - connectionId: string (required)
    //   - externalAccountId: string (required)
    //   - displayName: string (required)
    //   - status: string (required)
    //
    // Collection: ingestion_events
    // Document ID: auto-generated
    // Fields:
    //   - connectionId: string (required)
    //   - externalEventId: string (required)
    //   - eventType: string (required)
    //   - symbol: string (required)
    //   - side: string (required)
    //   - quantity: number (required)
    //   - eventTimestamp: string (required)
    //   - dedupeHash: string (required)
    //   - processed: bool (required)
    //
    // ===============================================================

    // Collection: trades
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - symbol: string (required)
    //   - side: string (required, LONG/SHORT)
    //   - quantity: number (required)
    //   - entryPrice: number (required)
    //   - exitPrice: number (required)
    //   - pnl: number (required)
    //   - entryTime: string (required)
    //   - exitTime: string (required)
    //   - dedupeHash: string (required)
    //
    // Collection: tagCategories
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - name: string (required)
    //   - tags: list (required, strings)
    //   - order: number (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: drawing_templates
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - type: string (required, ChartDrawing's drawing-tool type)
    //   - name: string (required, user-given template name)
    //   - style: map (required, DrawingTemplateStyle)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
         (request.auth.token.email == "jeanpaultru@gmail.com" && request.auth.token.email_verified == true));
    }

    function isMentor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Mentor';
    }

    // True when `ownerId` (the userId field on the document being read) is a
    // student who was actually assigned to the requesting mentor — assigned
    // via users/{studentId}.mentorId, set either by an Admin from Users &
    // Permissions or by the student themselves (see isValidMentorSelfAssign()
    // and the users/{userId} update rule below). A mentor cannot read a
    // student's data just by being a Mentor; the assignment has to point at
    // them specifically, regardless of who set it.
    function isAssignedMentor(ownerId) {
      return isMentor() &&
        exists(/databases/$(database)/documents/users/$(ownerId)) &&
        get(/databases/$(database)/documents/users/$(ownerId)).data.get('mentorId', null) == request.auth.uid;
    }

    // A student may pick their own mentor (Settings → Mentor) — "add a
    // mentor later in their journey" — without an Admin doing it for them.
    // The only real constraint: it has to actually point at a real Mentor-
    // role account, not an arbitrary uid (which would otherwise let someone
    // fabricate a fake "assignment" to a non-mentor, though the read grant
    // it enables is checked independently via isAssignedMentor() anyway, so
    // this is defense in depth, not the only thing standing between a
    // student and handing their data to the wrong account). null clears the
    // assignment (unassigning) and is always allowed.
    function isValidMentorSelfAssign(newMentorId) {
      return newMentorId == null || (
        exists(/databases/$(database)/documents/users/$(newMentorId)) &&
        get(/databases/$(database)/documents/users/$(newMentorId)).data.role == 'Mentor'
      );
    }

    // Viewer is meant to be genuinely read-only (per Users & Permissions'
    // own Role Templates reference: "Access to personal trading data
    // only") — before this, that was a label with nothing behind it; a
    // Viewer-role account could write to every collection exactly like a
    // Student. Added as one extra clause on each existing owner-write
    // check below, not a restructure, so read access (the entire point of
    // the role) is untouched.
    function canWriteOwnData() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'Viewer';
    }

    // An invite is a bearer token an Admin generates (Users & Permissions →
    // Invites) that lets a brand-new sign-in arrive with a role other than
    // the app's hardcoded 'Student' default, and optionally a pre-assigned
    // mentorId/groupId — see the users/{userId} create rule below, which is
    // the only place this actually matters. Valid means: exists, not
    // revoked, not expired, and not already fully used.
    function isValidInvite(inviteId) {
      return exists(/databases/$(database)/documents/invites/$(inviteId)) &&
        get(/databases/$(database)/documents/invites/$(inviteId)).data.get('revoked', false) != true &&
        get(/databases/$(database)/documents/invites/$(inviteId)).data.expiresAt > request.time &&
        get(/databases/$(database)/documents/invites/$(inviteId)).data.useCount <
          get(/databases/$(database)/documents/invites/$(inviteId)).data.maxUses;
    }

    // A personal referral link: any signed-in user (not just Admin) can
    // create ONE of these for themselves via Settings → Referrals. Hard-
    // locked to role: 'Student' — a real, usable account (can trade,
    // journal, everything scoped to their own data) but nothing that
    // touches anyone else's: no visibility into other users' data, no
    // admin surface, no ability to grant roles or manage anyone. That's
    // the actual privilege ceiling here, regardless of the referrer's own
    // role — Student write access is fully self-scoped throughout
    // firestore.rules (every owner-write check below is keyed to
    // request.auth.uid), so this is not an escalation path no matter who
    // created the link. An Admin can still promote a referred account to
    // anything afterward. No mentor/group pre-assignment either — a
    // referred Student picks their own mentor later (see the users update
    // rule's isValidMentorSelfAssign()), rather than the referrer choosing
    // one for them. Bounded maxUses/expiry so a leaked personal link can't
    // be turned into an unbounded standing invite.
    function isValidSelfServiceInvite(data) {
      return data.role == 'Student' &&
        data.get('mentorId', null) == null &&
        data.get('groupId', null) == null &&
        data.createdBy == request.auth.uid &&
        data.useCount == 0 &&
        data.get('revoked', false) == false &&
        data.maxUses is int && data.maxUses > 0 && data.maxUses <= 1000 &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time &&
        data.expiresAt <= request.time + duration.value(365, 'd');
    }

    function isValidDiagnostics(data) {
      return data.pnlResult in ['WIN', 'LOSS', 'BREAKEVEN'] &&
             data.holdType in ['SCALP', 'INTRADAY', 'SWING'] &&
             data.executionType in ['SINGLE_ENTRY', 'SCALED_IN', 'SCALED_OUT', 'FULL_SCALE'] &&
             data.efficiency is number &&
             data.dataInsight is string &&
             (!('adverseExcursion' in data) || data.adverseExcursion is number);
    }

    function isValidModelValidation(data) {
      return data.followsModel is bool &&
             data.violations is list &&
             (!('isManualOverride' in data) || data.isManualOverride is bool) &&
             (!('isUnconfirmed' in data) || data.isUnconfirmed is bool);
    }

    function isValidTrade(data) {
      return data.userId is string &&
             data.sessionDate is string &&
             data.symbol is string &&
             data.direction in ['LONG', 'SHORT'] &&
             data.entryTime is string &&
             data.exitTime is string &&
             data.avgEntryPrice is number &&
             data.avgExitPrice is number &&
             data.pnlPoints is number &&
             data.pnlCurrency is number &&
             data.isWinner is bool &&
             data.holdTimeSeconds is number &&
             data.totalQuantity is number &&
             data.dedupeHash is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             data.totalEntryValue is number &&
             data.totalExitValue is number &&
             data.realizedPnL is number &&
             data.maxPositionSize is number &&
             (!('diagnostics' in data) || isValidDiagnostics(data.diagnostics)) &&
             (!('modelValidation' in data) || isValidModelValidation(data.modelValidation));
    }

    function isValidTagCategory(data) {
      return data.userId is string &&
             data.name is string &&
             data.tags is list &&
             data.order is number &&
             data.createdAt is timestamp;
    }

    function isValidDrawingTemplate(data) {
      return data.userId is string &&
             data.type is string &&
             data.name is string &&
             data.style is map &&
             data.createdAt is timestamp;
    }

    function isValidTradeReview(data) {
      return data.userId is string &&
             data.tradeId is string &&
             (!('tradeGrade' in data) || data.tradeGrade in ['A+', 'A', 'B', 'C', 'D', 'F']) &&
             (!('diagnostics' in data) || isValidDiagnostics(data.diagnostics)) &&
             (!('modelValidation' in data) || isValidModelValidation(data.modelValidation));
    }

    function isValidStrategy(data) {
      return data.userId is string &&
             data.name is string &&
             data.status in ['active', 'archived'] &&
             data.categories is list;
    }

    // A logged pre-trade plan (see TradeIntent in types.ts / LogIntentModal)
    // — checks the fields actually written by TradeContext.logTradeIntent.
    // Previously validated isManualOverride/matchedTradeId, neither of
    // which that function ever wrote (it writes overrideUsed/tradeId) —
    // those checks were always trivially satisfied and never protected
    // anything; replaced with checks on the real fields below.
    function isValidTradeIntent(data) {
      return data.userId is string &&
             data.symbol is string &&
             data.direction in ['LONG', 'SHORT'] &&
             data.isValidSetup is bool &&
             data.overrideUsed is bool &&
             data.confirmedAt is string &&
             data.status in ['pending', 'matched', 'expired'] &&
             (!('plannedEntry' in data) || data.plannedEntry is number) &&
             (!('plannedExit' in data) || data.plannedExit is number) &&
             (!('stopLoss' in data) || data.stopLoss is number) &&
             (!('strategyId' in data) || data.strategyId is string) &&
             (!('strategyName' in data) || data.strategyName is string) &&
             (!('tradeId' in data) || data.tradeId is string);
    }

    function isValidMentorComment(data) {
      return data.authorId is string &&
             data.authorName is string &&
             data.authorRole in ['Mentor', 'Student', 'Admin'] &&
             data.text is string &&
             data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    // support_threads/{userId} — the summary doc behind the floating
    // support chat widget and the Admin inbox (Users & Permissions →
    // Support). One thread per user, keyed by their own uid — same
    // "doc ID doubles as the access key" pattern as everywhere else in
    // this file. `writerIsOwner` picks which of the two directions is
    // being validated: the thread's owner sending a message always marks
    // it unread-for-Admin and leaves unread-for-user alone (they obviously
    // already know about their own message); Admin's own writes are
    // validated by the same shape but not constrained by this function —
    // isAdmin() already covers that branch.
    function isValidSupportThread(data, writerIsOwner) {
      return data.userId is string &&
             data.userName is string &&
             data.userEmail is string &&
             data.lastMessageText is string &&
             data.lastMessageAt is timestamp &&
             data.lastMessageBy in ['user', 'admin'] &&
             data.unreadByAdmin is bool &&
             data.unreadByUser is bool &&
             (!writerIsOwner || (data.lastMessageBy == 'user' && data.unreadByAdmin == true));
    }

    function isValidSupportMessage(data) {
      return data.senderId is string &&
             data.senderName is string &&
             data.senderRole in ['user', 'admin'] &&
             data.text is string &&
             data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    // Connection Test
    match /test/connection {
      allow read: if true;
    }

    // Broker Connections
    match /broker_connections/{connectionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData();
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());

      match /accounts/{accountId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/broker_connections/$(connectionId)).data.userId == request.auth.uid || isAdmin());
        allow write: if isAuthenticated() && ((get(/databases/$(database)/documents/broker_connections/$(connectionId)).data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());

        match /transactions/{transactionId} {
          allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData();
          allow update, delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
        }
      }
    }

    // Trades
    match /trades/{tradeId} {
      // Mentors get read-only access to their assigned students' trades —
      // this is a coaching view, not a management one, so update/delete
      // stay owner-or-Admin only (a mentor can't edit or delete a
      // student's trade record).
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isAssignedMentor(resource.data.userId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidTrade(request.resource.data);
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin()) && isValidTrade(request.resource.data);
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
    }

    // Ingestion Events
    match /ingestion_events/{eventId} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/broker_connections/$(resource.data.connectionId)).data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Only backend/admin should write events directly
    }

    // Ingestion Errors
    match /ingestion_errors/{errorId} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/broker_connections/$(resource.data.connectionId)).data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Sync Checkpoints
    match /sync_checkpoints/{checkpointId} {
      allow read, write: if isAdmin();
    }

    // Tradovate OAuth state → verified-uid binding (see server.ts's
    // /api/auth/tradovate/url and /callback). Written and read only by the
    // server via the Admin SDK, which bypasses these rules entirely — this
    // exists purely so a client can never read or forge one directly.
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }

    // Position State
    match /position_state/{stateId} {
      allow read, write: if isAdmin();
    }
    
    // Import Runs
    match /import_runs/{runId} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/broker_connections/$(resource.data.connectionId)).data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData();
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
      allow delete: if isAdmin();
    }

    // Trade Reviews
    match /trade_reviews/{reviewId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidTradeReview(request.resource.data);
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin()) && isValidTradeReview(request.resource.data);
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
    }

    // Tag Categories
    match /tagCategories/{categoryId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidTagCategory(request.resource.data);
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin()) && isValidTagCategory(request.resource.data);
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
    }

    // Drawing Templates
    match /drawing_templates/{templateId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidDrawingTemplate(request.resource.data);
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin()) && isValidDrawingTemplate(request.resource.data);
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
    }

    // Strategies
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - name: string (required)
    //   - icon: string (optional, single emoji)
    //   - status: string (required, active/archived)
    //   - categories: list (required, StrategyCategory[] — name + nested rules,
    //     each rule optionally carrying a showWhen outcome filter)
    //   - createdAt/updatedAt: string (required)
    match /strategies/{strategyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidStrategy(request.resource.data);
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin()) && isValidStrategy(request.resource.data);
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
    }

    // Day View "Review with AI" cache — same shape as ingestion_events:
    // the server (Admin SDK, /api/day-review/generate) is the only writer,
    // since it's the one calling the model and paying for the generation;
    // clients only ever read their own cached reviews.
    match /session_reviews/{reviewId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Only backend/admin should write reviews directly
    }

    // Trade Intents
    match /trade_intents/{intentId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData() && isValidTradeIntent(request.resource.data);
      allow update: if isAuthenticated() && ((isDocOwner() && canWriteOwnData()) || isAdmin()) && isValidTradeIntent(request.resource.data);
      allow delete: if isAuthenticated() && ((isDocOwner() && canWriteOwnData()) || isAdmin());
    }

    // Journals
    match /journals/{journalId} {
      // Same read-only mentor access as trades — see isAssignedMentor().
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isAssignedMentor(resource.data.userId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && canWriteOwnData();
      allow update: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());
      allow delete: if isAuthenticated() && ((resource.data.userId == request.auth.uid && canWriteOwnData()) || isAdmin());

      // The mentor feedback loop: a real two-way thread on this entry
      // between its owner and their assigned mentor. Append-only (no
      // update — comments can't be edited after posting) and
      // authorRole is checked against the writer's actual current role
      // so a student can't post a reply tagged as if it came from their
      // mentor.
      match /mentorComments/{commentId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/journals/$(journalId)).data.userId == request.auth.uid ||
          isAdmin() ||
          isAssignedMentor(get(/databases/$(database)/documents/journals/$(journalId)).data.userId)
        );
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
          canWriteOwnData() &&
          isValidMentorComment(request.resource.data) &&
          (
            get(/databases/$(database)/documents/journals/$(journalId)).data.userId == request.auth.uid ||
            isAssignedMentor(get(/databases/$(database)/documents/journals/$(journalId)).data.userId) ||
            isAdmin()
          );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Users & Permissions' real audit trail — admin-only in both
    // directions, matching the Users collection's own admin-managed
    // nature; a client never needs to read another admin's action log
    // except from this same admin-only screen.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isAdmin();
      allow update, delete: if false;
    }

    // Support chat — the floating widget (any signed-in user) and the
    // Admin inbox it feeds (Users & Permissions → Support). `get` is open
    // to the thread's own owner or any Admin so a user can read their own
    // thread by its known id (their own uid); `list` (browsing every
    // thread that exists — the inbox view) is Admin-only, same isolation
    // as invites' bearer-token design elsewhere in this file. The thread
    // doc itself is written by whichever side just sent a message — the
    // owner via the constrained isValidSupportThread() branch, Admin
    // unconstrained (they're also who clears unreadByAdmin after reading).
    match /support_threads/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.userId == userId && isValidSupportThread(request.resource.data, true)) ||
        (isAdmin() && isValidSupportThread(request.resource.data, false))
      );
      allow update: if isAuthenticated() && (
        (isOwner(userId) && isValidSupportThread(request.resource.data, true)) ||
        (isAdmin() && isValidSupportThread(request.resource.data, false))
      );
      allow delete: if isAdmin();

      // Append-only, same immutability as journals/{id}/mentorComments —
      // no editing or deleting your own message after sending, only Admin
      // can moderate (delete) one.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isValidSupportMessage(request.resource.data) && (
          (isOwner(userId) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'user') ||
          (isAdmin() && request.resource.data.senderRole == 'admin')
        );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Users
    // Fields (see AuthContext.tsx / UsersPermissionsScreen.tsx):
    //   - role: string (Admin/Mentor/Student/Viewer) — Admin-assigned, or
    //     invite-assigned at creation only (see below)
    //   - mentorId: string, optional — the Mentor-role uid this Student is
    //     assigned to; Admin- or invite-assigned only
    //   - groupId: string, optional — cohort label (see /groups); Admin- or
    //     invite-assigned only, purely organizational, not an access grant
    //   - inviteCode: string, optional — which invite (if any) was redeemed
    //     to create this account; audit trail only, never re-checked later
    //   - referredBy/referredByName: string, optional — the uid/name of
    //     whoever's invite (personal referral link or Admin cohort invite)
    //     was used to create this account. Set once at creation from the
    //     invite's own createdBy/createdByName, immutable after — the
    //     tracking layer for "how are users joining" today, and the
    //     foundation for whatever the eventual referral reward system
    //     reads from (not built yet — see Settings → Referrals)
    //   - status, name, email, updatedAt
    match /users/{userId} {
      allow read: if isAuthenticated();
      // A brand-new sign-in creates its own doc one of two ways:
      //   1. No invite: the app's fixed default — role Student, no mentor,
      //      group, or referral attribution. This is the only path a
      //      non-Admin ever sets role without an invite.
      //   2. With an invite: role/mentorId/groupId must match EXACTLY what
      //      that invite grants (isValidInvite + the get()s below), and
      //      referredBy/referredByName must match EXACTLY the invite's own
      //      createdBy/createdByName — a redeemer can't claim credit for a
      //      referral that isn't theirs, or invent one that doesn't exist.
      //      An invite is the only way a non-Admin can arrive as anything
      //      other than Student, with a mentor/group, or with referral
      //      attribution, on their very first write ever. See
      //      isValidInvite() and the /invites collection rules for how the
      //      invite itself is created (Admin, or a capped self-service
      //      Viewer-only referral link) and marked used (below).
      allow create: if isAuthenticated() && isOwner(userId) && (
        (request.resource.data.role == 'Student' &&
         request.resource.data.get('mentorId', null) == null &&
         request.resource.data.get('groupId', null) == null &&
         request.resource.data.get('referredBy', null) == null &&
         request.resource.data.get('referredByName', null) == null &&
         !('inviteCode' in request.resource.data))
        ||
        (
          'inviteCode' in request.resource.data &&
          isValidInvite(request.resource.data.inviteCode) &&
          request.resource.data.role ==
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role &&
          request.resource.data.get('mentorId', null) ==
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('mentorId', null) &&
          request.resource.data.get('groupId', null) ==
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('groupId', null) &&
          request.resource.data.get('referredBy', null) ==
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.createdBy &&
          request.resource.data.get('referredByName', null) ==
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('createdByName', null)
        )
      );
      // After that, role/groupId/referredBy/referredByName are Admin-only
      // to change — this is the actual security boundary for the app's
      // access model, not just a UI restriction. Without it, any signed-in
      // user could grant themselves Admin (or assign themselves a group,
      // or fake/erase their referral attribution) with a raw Firestore
      // write, bypassing Users & Permissions entirely. mentorId is the one
      // exception: an owner may change their own, but only to a real
      // Mentor-role account (or null) — see isValidMentorSelfAssign() —
      // "add a mentor later in their journey" without needing an Admin to
      // do it for them; Admin can still freely reassign it too. An owner
      // can still update their own other fields (name/email/status sync on
      // login, or their own referralCode — see Settings → Referrals) as
      // long as these four stay unchanged.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('groupId', null) == resource.data.get('groupId', null) &&
        request.resource.data.get('referredBy', null) == resource.data.get('referredBy', null) &&
        request.resource.data.get('referredByName', null) == resource.data.get('referredByName', null) &&
        isValidMentorSelfAssign(request.resource.data.get('mentorId', null))
      );
      allow delete: if isAdmin();
    }

    // Invites — the real mechanism behind Users & Permissions' "Generate
    // Invite" AND Settings → Referrals' personal referral link (same
    // collection, two ways to create one). An invite is a bearer token:
    // whoever has the link (the invite's doc ID, a random code) can redeem
    // it once, that's the entire point. `get` is open to any authenticated
    // user so a brand-new sign-in can look up the one invite they were
    // given; `list` (browsing/enumerating every invite that exists) is
    // Admin-only, so a non-Admin can never discover a code they weren't
    // given — including another user's referral code.
    match /invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      // Admin: unrestricted (Users & Permissions → Invites). Anyone else:
      // only their own personal referral link, hard-capped to role Viewer
      // — see isValidSelfServiceInvite().
      allow create: if isAdmin() || (isAuthenticated() && isValidSelfServiceInvite(request.resource.data));
      allow update: if isAdmin() || (
        isAuthenticated() && isValidInvite(inviteId) && (
          // Redemption: bump useCount by exactly 1 and change nothing
          // else, and only while the invite is still valid — this is what
          // actually marks it (partially) used.
          (
            request.resource.data.useCount == resource.data.useCount + 1 &&
            request.resource.data.get('revoked', false) == resource.data.get('revoked', false)
          )
          ||
          // Self-revoke: the invite's own creator may flip revoked to
          // true (e.g. "Regenerate Link" in Settings → Referrals) and
          // nothing else — same immutability as redemption above, just
          // the opposite field allowed to change.
          (
            resource.data.createdBy == request.auth.uid &&
            request.resource.data.revoked == true &&
            request.resource.data.useCount == resource.data.useCount
          )
        ) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('mentorId', null) == resource.data.get('mentorId', null) &&
        request.resource.data.get('groupId', null) == resource.data.get('groupId', null) &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.maxUses == resource.data.maxUses &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.label == resource.data.label &&
        request.resource.data.createdBy == resource.data.createdBy
      );
      allow delete: if isAdmin();
    }

    // Groups — a purely organizational label (cohort name) used by bulk
    // invites and rostering in Users & Permissions. Deliberately NOT an
    // access-control mechanism: a group's mentorId is only a UI default
    // applied when generating invites for that group. The actual grant
    // that lets a Mentor read a student's data stays users/{uid}.mentorId
    // alone (see isAssignedMentor()), completely unchanged by this —
    // adding someone to a group never by itself grants anyone read access.
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
